# Railway inyecta esta automáticamente si agregas el plugin de Postgres
# al proyecto y la referencias como ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Genera una clave fija de al menos 32 caracteres (no la cambies después)
JWT_SECRET=genera_una_clave_segura_de_32_caracteres_o_mas

# JSON array de usuarios admin. La contraseña va como hash bcrypt, nunca en texto plano.
# Ejemplo: [{"username":"admin","hash":"$2a$10$...","nombre":"Juan"}]
AUTH_USERS=[]

# Mismo valor que DASHBOARD_API_KEY en el servicio de n8n
DASHBOARD_API_KEY=genera_un_secreto_compartido_con_n8n

PORT=${PORT}
NODE_ENV=production
